generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"

}

model dashboard_insights {
  id         Int       @id @default(autoincrement())
  user_id    Int?      @unique(map: "unique_user_dashboard")
  focus      String[]
  streak     Int?
  progress   Json?
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model journals {
  id         Int       @id(map: "journals_pkey1") @default(autoincrement())
  user_id    Int?
  title      String?
  content    String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "journals_user_id_fkey1")
}

model learnings {
  id        Int       @id(map: "journals_pkey") @default(autoincrement())
  user_id   Int?
  title     String
  summary   String
  keypoints Json?
  createdat DateTime? @default(now()) @db.Timestamp(6)
  users     users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "journals_user_id_fkey")
}

model users {
  id                 Int                 @id @default(autoincrement())
  name               String              @db.VarChar(255)
  email              String              @unique @db.VarChar(255)
  password           String              @db.VarChar(255)
  dashboard_insights dashboard_insights?
  journals           journals[]
  learnings          learnings[]
  weekly_analysis    weekly_analysis[]
}

model weekly_analysis {
  id             Int       @id @default(autoincrement())
  user_id        Int?
  title          String?
  summary        String?
  skills         String[]
  gaps           String[]
  recommendation String[]
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  users          users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
